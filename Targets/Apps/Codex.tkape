Description: OpenAI Codex artifacts
Author: Phill Moore
Version: 1.0
Id: f3a98af7-6a4d-4169-8447-3e9e499dbbc3
RecreateDirectories: true
Targets:
    -
        Name: Codex Home Directory
        Category: Apps
        Path: C:\Users\%user%\.codex\
        Recursive: true
        Comment: "Collects Codex configuration, sessions, and related persisted home-directory artifacts"

